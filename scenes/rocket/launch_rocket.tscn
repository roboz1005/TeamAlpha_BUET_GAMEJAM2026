[sub_resource type="GDScript" id="GDScript_l2oig"]
script/source = "extends Node2D
class_name LaunchRocket

@export var debris_scene: PackedScene = preload(\"res://scenes/entities/debris.tscn\")
@export var lane_count: int = 5
@export var total_distance: float = 3000.0
@export var base_travel_speed: float = 60.0
@export var base_spawn_interval: float = 1.2
@export var min_spawn_interval: float = 0.4
@export var base_debris_speed: float = 120.0
@export var max_debris_speed: float = 260.0

var distance_traveled: float = 0.0
var is_running: bool = true
var play_width: float = 480.0
var previous_window_size: Vector2i

@onready var ship: Spaceship = $Ship
@onready var debris_spawn_timer: Timer = $DebrisSpawnTimer
@onready var distance_label: Label = $HUD/Control/DistanceLabel
@onready var pause_button: Button = $HUD/Control/PauseButton
@onready var pause_menu: PauseMenu = $PauseMenu
@onready var death_screen: DeathScreen = $DeathScreen
@onready var win_layer: CanvasLayer = $WinLayer
@onready var video_player: VideoStreamPlayer = $WinLayer/VideoStreamPlayer
@onready var fade_rect: ColorRect = $WinLayer/FadeRect

func _ready() -> void:
	# Landscape -> portrait: swap width and height so this always matches
	# whatever resolution your project actually runs at.
	previous_window_size = DisplayServer.window_get_size()
	var portrait_size := Vector2i(previous_window_size.y, previous_window_size.x)
	DisplayServer.window_set_size(portrait_size)
	play_width = float(portrait_size.x)
	ship.half_width = play_width / 2.0 - 40.0

	death_screen.visible = false
	win_layer.visible = false
	fade_rect.modulate.a = 0.0

	_schedule_next_spawn()

func _exit_tree() -> void:
	DisplayServer.window_set_size(previous_window_size)

func _process(delta: float) -> void:
	if not is_running:
		return
	var progress: float = clamp(distance_traveled / total_distance, 0.0, 1.0)
	distance_traveled += (base_travel_speed + progress * base_travel_speed) * delta
	distance_label.text = \"Distance to Moon: %d / %d\" % [int(distance_traveled), int(total_distance)]
	if distance_traveled >= total_distance:
		_on_moon_reached()

func _schedule_next_spawn() -> void:
	var progress: float = clamp(distance_traveled / total_distance, 0.0, 1.0)
	var interval: float = lerp(base_spawn_interval, min_spawn_interval, progress)
	debris_spawn_timer.start(interval)

# \"signal\" — DebrisSpawnTimer(Timer).timeout -> _on_debris_spawn_timer_timeout()
func _on_debris_spawn_timer_timeout() -> void:
	if not is_running:
		return
	_spawn_debris_wave()
	_schedule_next_spawn()

func _spawn_debris_wave() -> void:
	var progress: float = clamp(distance_traveled / total_distance, 0.0, 1.0)
	var lanes: Array[int] = []
	for i in lane_count:
		lanes.append(i)
	lanes.shuffle()

	# Never blocks every lane — at least one always stays open, and more
	# lanes get blocked as you get closer to the Moon.
	var max_blocked: int = max(1, min(lane_count - 1, 1 + int(progress * (lane_count - 2))))
	var lane_width: float = play_width / float(lane_count)

	for i in max_blocked:
		var lane: int = lanes[i]
		var debris: Debris = debris_scene.instantiate()
		debris.speed = lerp(base_debris_speed, max_debris_speed, progress)
		add_child(debris)
		var x: float = (lane + 0.5) * lane_width - (play_width / 2.0)
		debris.global_position = ship.global_position + Vector2(x, -600)

func ship_hit() -> void:
	if not is_running:
		return
	is_running = false
	debris_spawn_timer.stop()
	$HUD.visible = false
	death_screen.visible = true
	get_tree().paused = true

func _on_moon_reached() -> void:
	is_running = false
	debris_spawn_timer.stop()
	win_layer.visible = true
	if video_player.stream:
		video_player.play()
	else:
		_start_fade()

# \"signal\" — VideoStreamPlayer.finished -> _on_video_stream_player_finished()
func _on_video_stream_player_finished() -> void:
	_start_fade()

func _start_fade() -> void:
	var tween := create_tween()
	tween.tween_property(fade_rect, \"modulate:a\", 1.0, 1.2)
	tween.tween_callback(GameManager.complete_earth_map)

# \"signal\" — PauseButton(Button).pressed -> _on_pause_button_pressed()
func _on_pause_button_pressed() -> void:
	get_tree().paused = true
	pause_menu.visible = true
"

